<?xml version="1.0"?>
<sdf version="1.9">
  <model name="stream_camera">
    <static>true</static>
    <pose>0 0 2 0 0 0</pose>
    <link name="camera_link">
      <sensor name="camera_front" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.0</horizontal_fov>
          <image><width>320</width><height>240</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>100</far></clip>
        </camera>
        <plugin filename="libGstPlaneCameraSystem.so" name="custom::GstPlaneCameraSystem">
          <camera_name>camera_front</camera_name>
          <udp_host>127.0.0.1</udp_host>
          <udp_port>5606</udp_port>
          <rate>30</rate>
          <bitrate_kbps>16384</bitrate_kbps>
          <use_cuda>false</use_cuda>
          <x264_speed_preset>1</x264_speed_preset>
        </plugin>
      </sensor>
      <sensor name="camera_down" type="camera">
        <pose>0 0 0 0 1.57079632679 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.0</horizontal_fov>
          <image><width>320</width><height>240</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>100</far></clip>
        </camera>
        <plugin filename="libGstPlaneCameraSystem.so" name="custom::GstPlaneCameraSystem">
          <camera_name>camera_down</camera_name>
          <udp_host>127.0.0.1</udp_host>
          <udp_port>5604</udp_port>
          <rate>15</rate>
          <bitrate_kbps>4096</bitrate_kbps>
          <use_cuda>false</use_cuda>
          <x264_speed_preset>1</x264_speed_preset>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
